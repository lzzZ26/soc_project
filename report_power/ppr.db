<tables>
    <table id="report_power_power_summary" title="Power Summary" column_number="2">
        <column_headers>
            <data>Name</data>
            <data>Value</data>
        </column_headers>
        <comment>
            <data>Notice:</data>
            <data>    The result of power analysis is based on the voltage list in [Settings] -&gt; [Power Supply] table.</data>
            <data>    And no margin for power supply reserved.</data>
        </comment>
        <row>
            <data>Total On Chip Power</data>
            <data>0.581</data>
        </row>
        <row>
            <data>Static Power</data>
            <data>0.152</data>
        </row>
        <row>
            <data>External Power</data>
            <data>0</data>
        </row>
        <row>
            <data>Junction Temperature</data>
            <data>31.181</data>
        </row>
        <row>
            <data>Thermal Margin</data>
            <data>68.819</data>
        </row>
        <row>
            <data>Power Margin</data>
            <data>6.468</data>
        </row>
    </table>
