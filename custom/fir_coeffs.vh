localparam signed [15:0] H51 = 16'shFCE4;   // -796
localparam signed [15:0] H52 = 16'sh0000;   // 0
localparam signed [15:0] H53 = 16'sh0272;   // 626
localparam signed [15:0] H54 = 16'sh0000;   // 0
localparam signed [15:0] H55 = 16'shFE0E;   // -498
localparam signed [15:0] H56 = 16'sh0000;   // 0
localparam signed [15:0] H57 = 16'sh018D;   // 397
localparam signed [15:0] H58 = 16'sh0000;   // 0
localparam signed [15:0] H59 = 16'shFEC4;   // -316
localparam signed [15:0] H60 = 16'sh0000;   // 0
localparam signed [15:0] H61 = 16'sh00FA;   // 250
localparam signed [15:0] H62 = 16'sh0000;   // 0
