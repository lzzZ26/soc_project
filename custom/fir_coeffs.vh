localparam signed [15:0] H78 = 16'sh0000;   // 0
localparam signed [15:0] H79 = 16'shFFEA;   // -22
localparam signed [15:0] H80 = 16'sh0000;   // 0
localparam signed [15:0] H81 = 16'sh0000;   // 0 (82nd tap, runtime configurable)

function signed [15:0] fir_coeff;
    input integer idx;
    begin
        case (idx)
            0: fir_coeff = H0 ;
            1: fir_coeff = H1 ;
            2: fir_coeff = H2 ;
            3: fir_coeff = H3 ;
            4: fir_coeff = H4 ;
            5: fir_coeff = H5 ;
            6: fir_coeff = H6 ;
            7: fir_coeff = H7 ;
            8: fir_coeff = H8 ;
            9: fir_coeff = H9 ;
            10: fir_coeff = H10;
            11: fir_coeff = H11;
            12: fir_coeff = H12;
            13: fir_coeff = H13;
            14: fir_coeff = H14;
            15: fir_coeff = H15;
            16: fir_coeff = H16;
            17: fir_coeff = H17;
