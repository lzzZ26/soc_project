            36: fir_coeff = H36;
            37: fir_coeff = H37;
            38: fir_coeff = H38;
            39: fir_coeff = H39;
            40: fir_coeff = H40;
            41: fir_coeff = H41;
            42: fir_coeff = H42;
            43: fir_coeff = H43;
            44: fir_coeff = H44;
            45: fir_coeff = H45;
            46: fir_coeff = H46;
            47: fir_coeff = H47;
            48: fir_coeff = H48;
            49: fir_coeff = H49;
            50: fir_coeff = H50;
            51: fir_coeff = H51;
            52: fir_coeff = H52;
            53: fir_coeff = H53;
            54: fir_coeff = H54;
            55: fir_coeff = H55;
            56: fir_coeff = H56;
            57: fir_coeff = H57;
            58: fir_coeff = H58;
            59: fir_coeff = H59;
            60: fir_coeff = H60;
            61: fir_coeff = H61;
            62: fir_coeff = H62;
            63: fir_coeff = H63;
            64: fir_coeff = H64;
            65: fir_coeff = H65;
            66: fir_coeff = H66;
            67: fir_coeff = H67;
            68: fir_coeff = H68;
            69: fir_coeff = H69;
            70: fir_coeff = H70;
            71: fir_coeff = H71;
            72: fir_coeff = H72;
            73: fir_coeff = H73;
            74: fir_coeff = H74;
            75: fir_coeff = H75;
            76: fir_coeff = H76;
            77: fir_coeff = H77;
            78: fir_coeff = H78;
            79: fir_coeff = H79;
            80: fir_coeff = H80;
            81: fir_coeff = H81;
            default: fir_coeff = 16'sh0000;
        endcase
    end
endfunction
