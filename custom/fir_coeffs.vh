// Extended from the generated 81-tap set to 82 taps (81st order).
// Original set: 81-tap linear-phase FIR, Q1.15 two's complement,
// fc = 0.25 * fs, symmetric H[k] == H[80-k].
// H81 = 0 keeps the default response identical to the original filter;
// all 82 coefficients are independent and can be rewritten at runtime,
// so arbitrary non-symmetric coefficient sets are supported.

localparam integer FIR_NSAMP = 5404;   // stimulus / reference length

localparam signed [15:0] H0  = 16'sh0000;   // 0
localparam signed [15:0] H1  = 16'shFFEA;   // -22
localparam signed [15:0] H2  = 16'sh0000;   // 0
localparam signed [15:0] H3  = 16'sh001A;   // 26
localparam signed [15:0] H4  = 16'sh0000;   // 0
localparam signed [15:0] H5  = 16'shFFDE;   // -34
localparam signed [15:0] H6  = 16'sh0000;   // 0
localparam signed [15:0] H7  = 16'sh002F;   // 47
localparam signed [15:0] H8  = 16'sh0000;   // 0
localparam signed [15:0] H9  = 16'shFFC0;   // -64
localparam signed [15:0] H10 = 16'sh0000;   // 0
localparam signed [15:0] H11 = 16'sh0057;   // 87
localparam signed [15:0] H12 = 16'sh0000;   // 0
localparam signed [15:0] H13 = 16'shFF8C;   // -116
localparam signed [15:0] H14 = 16'sh0000;   // 0
localparam signed [15:0] H15 = 16'sh0098;   // 152
localparam signed [15:0] H16 = 16'sh0000;   // 0
localparam signed [15:0] H17 = 16'shFF3C;   // -196
localparam signed [15:0] H18 = 16'sh0000;   // 0
localparam signed [15:0] H19 = 16'sh00FA;   // 250
localparam signed [15:0] H20 = 16'sh0000;   // 0
localparam signed [15:0] H21 = 16'shFEC4;   // -316
localparam signed [15:0] H22 = 16'sh0000;   // 0
localparam signed [15:0] H23 = 16'sh018D;   // 397
localparam signed [15:0] H24 = 16'sh0000;   // 0
localparam signed [15:0] H25 = 16'shFE0E;   // -498
localparam signed [15:0] H26 = 16'sh0000;   // 0
localparam signed [15:0] H27 = 16'sh0272;   // 626
localparam signed [15:0] H28 = 16'sh0000;   // 0
localparam signed [15:0] H29 = 16'shFCE4;   // -796
localparam signed [15:0] H30 = 16'sh0000;   // 0
localparam signed [15:0] H31 = 16'sh0408;   // 1032
localparam signed [15:0] H32 = 16'sh0000;   // 0
localparam signed [15:0] H33 = 16'shFA92;   // -1390
localparam signed [15:0] H34 = 16'sh0000;   // 0
localparam signed [15:0] H35 = 16'sh07DE;   // 2014
localparam signed [15:0] H36 = 16'sh0000;   // 0
localparam signed [15:0] H37 = 16'shF295;   // -3435
localparam signed [15:0] H38 = 16'sh0000;   // 0
localparam signed [15:0] H39 = 16'sh28B6;   // 10422
localparam signed [15:0] H40 = 16'sh400B;   // 16395
localparam signed [15:0] H41 = 16'sh28B6;   // 10422
localparam signed [15:0] H42 = 16'sh0000;   // 0
localparam signed [15:0] H43 = 16'shF295;   // -3435
localparam signed [15:0] H44 = 16'sh0000;   // 0
localparam signed [15:0] H45 = 16'sh07DE;   // 2014
localparam signed [15:0] H46 = 16'sh0000;   // 0
localparam signed [15:0] H47 = 16'shFA92;   // -1390
localparam signed [15:0] H48 = 16'sh0000;   // 0
