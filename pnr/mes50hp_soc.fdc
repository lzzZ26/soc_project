# MES50HP Board Constraint File (PGL50H-6IFBG484)
# SoC System - Cortex-M0 + AXI Crossbar + FIR + DMA
#
# Board:  盘古50 (MES50HP) - PGL50H-6IFBG484
# Clock:  50MHz on pin P20
# UART0:  TX=R9, RX=R8 (connected to CP2102 USB-UART)
# LED1-8: BANK0 pins B2/A2/B3/A3/C5/A5/F7/F8
# KEY1:   K18 (active low reset)

###==== BEGIN "create_clock"
create_clock -name {clk_50m} [get_ports {clk_50m}] -period {20} -waveform {0.000 10.000}
###==== END "create_clock"

###==== BEGIN "set_false_path"
set_false_path -from [get_ports {key1_n}]
###==== END "set_false_path"

###==== BEGIN Io Table
# Clock: FPGA_GCLK_50M = P20
define_attribute {p:clk_50m} {PAP_IO_DIRECTION} {Input}
define_attribute {p:clk_50m} {PAP_IO_LOC}       {P20}
define_attribute {p:clk_50m} {PAP_IO_VCCIO}     {3.3}
define_attribute {p:clk_50m} {PAP_IO_STANDARD}  {LVCMOS33}
define_attribute {p:clk_50m} {PAP_IO_NONE}      {TRUE}

# Reset: KEY1 = K18 (active low)
define_attribute {p:key1_n} {PAP_IO_DIRECTION} {Input}
define_attribute {p:key1_n} {PAP_IO_LOC}       {K18}
define_attribute {p:key1_n} {PAP_IO_VCCIO}     {3.3}
define_attribute {p:key1_n} {PAP_IO_STANDARD}  {LVCMOS33}
define_attribute {p:key1_n} {PAP_IO_NONE}      {TRUE}
define_attribute {p:key1_n} {PAP_IO_PULLUP}    {TRUE}

# UART0 TX -> CP2102 RX (pin R9)
define_attribute {p:uart0_tx} {PAP_IO_DIRECTION} {Output}
define_attribute {p:uart0_tx} {PAP_IO_LOC}       {R9}
define_attribute {p:uart0_tx} {PAP_IO_VCCIO}     {3.3}
define_attribute {p:uart0_tx} {PAP_IO_STANDARD}  {LVCMOS33}
define_attribute {p:uart0_tx} {PAP_IO_DRIVE}     {8}
define_attribute {p:uart0_tx} {PAP_IO_NONE}      {TRUE}
define_attribute {p:uart0_tx} {PAP_IO_SLEW}      {FAST}

# UART0 RX <- CP2102 TX (pin R8)
define_attribute {p:uart0_rx} {PAP_IO_DIRECTION} {Input}
define_attribute {p:uart0_rx} {PAP_IO_LOC}       {R8}
define_attribute {p:uart0_rx} {PAP_IO_VCCIO}     {3.3}
define_attribute {p:uart0_rx} {PAP_IO_STANDARD}  {LVCMOS33}
define_attribute {p:uart0_rx} {PAP_IO_NONE}      {TRUE}
define_attribute {p:uart0_rx} {PAP_IO_PULLUP}    {TRUE}

# LED1 = B2
define_attribute {p:led[0]} {PAP_IO_DIRECTION} {Output}
define_attribute {p:led[0]} {PAP_IO_LOC}       {B2}
define_attribute {p:led[0]} {PAP_IO_VCCIO}     {3.3}
define_attribute {p:led[0]} {PAP_IO_STANDARD}  {LVCMOS33}
define_attribute {p:led[0]} {PAP_IO_DRIVE}     {8}
define_attribute {p:led[0]} {PAP_IO_NONE}      {TRUE}
define_attribute {p:led[0]} {PAP_IO_SLEW}      {SLOW}

# LED2 = A2
define_attribute {p:led[1]} {PAP_IO_DIRECTION} {Output}
define_attribute {p:led[1]} {PAP_IO_LOC}       {A2}
define_attribute {p:led[1]} {PAP_IO_VCCIO}     {3.3}
define_attribute {p:led[1]} {PAP_IO_STANDARD}  {LVCMOS33}
